# Copia este archivo como backend/.env y ajusta los valores. NUNCA subas .env al repositorio.

# Conexión a PostgreSQL (el contenedor "db" de docker-compose expone el puerto 5433 en tu equipo)
DATABASE_URL=postgres://fastparking:fastparking_local@localhost:5433/fastparking

# Base de datos para las pruebas automatizadas (npm test)
TEST_DATABASE_URL=postgres://fastparking:fastparking_local@localhost:5433/fastparking_test

# Puerto de la API
PORT=3000

# Clave que debe enviar el simulador en la cabecera x-simulator-key (inventa una para tu entorno local)
SIMULATOR_API_KEY=cambia-esta-clave

# Reglas de negocio configurables
RETENTION_MINUTES=7
SESSION_HOURS=12
EXPIRATION_INTERVAL_MS=15000

# Pago simulado (RF-11): tarifa ILUSTRATIVA por minuto en COP y minutos para salir tras pagar
TARIFA_POR_MINUTO=130
MINUTOS_PARA_SALIR=15

# --- v2.0: agente de IA (RF-18, D-19) ---
# Proveedor LLM compatible con la API de OpenAI. Por defecto Gemini (Google AI Studio).
# La clave real va SOLO en tu .env local y en Render. Vacía = el agente usa el plan B por reglas.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Tiempo máximo que esperamos al LLM antes de decidir por reglas (milisegundos)
LLM_TIMEOUT_MS=8000

# --- v2.0: modo simulación del iPad (/simulacion, D-24) ---
# PIN que pide el iPad para encender el tráfico y lanzar el "carro intruso". Vacío = controles deshabilitados.
DEMO_PIN=
