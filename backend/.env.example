# Copia este archivo como backend/.env y ajusta los valores. NUNCA subas .env al repositorio.

# Conexión a PostgreSQL (el contenedor "db" de docker-compose expone el puerto 5433 en tu equipo)
DATABASE_URL=postgres://fastparking:fastparking_local@localhost:5433/fastparking

# Base de datos para las pruebas automatizadas (npm test)
TEST_DATABASE_URL=postgres://fastparking:fastparking_local@localhost:5433/fastparking_test

# Puerto de la API
PORT=3000

# Clave que debe enviar el simulador en la cabecera x-simulator-key (inventa una para tu entorno local)
SIMULATOR_API_KEY=cambia-esta-clave

# Reglas de negocio configurables
RETENTION_MINUTES=10
SESSION_HOURS=12
EXPIRATION_INTERVAL_MS=15000
