<bpmn:sequenceFlow id="F_T_Bloquear_G_Cupo" name="" sourceRef="T_Bloquear" targetRef="G_Cupo" />
<bpmn:sequenceFlow id="F_G_Cupo_T_Alternativas" name="No" sourceRef="G_Cupo" targetRef="T_Alternativas" />
<bpmn:sequenceFlow id="F_T_Alternativas_T_Solicitar" name="elige otra zona" sourceRef="T_Alternativas" targetRef="T_Solicitar" />
<bpmn:sequenceFlow id="F_G_Cupo_T_Crear" name="Sí" sourceRef="G_Cupo" targetRef="T_Crear" />
<bpmn:sequenceFlow id="F_T_Crear_T_Mostrar" name="" sourceRef="T_Crear" targetRef="T_Mostrar" />
<bpmn:sequenceFlow id="F_T_Mostrar_G_Espera" name="" sourceRef="T_Mostrar" targetRef="G_Espera" />
<bpmn:sequenceFlow id="F_G_Espera_C_Cancel" name="" sourceRef="G_Espera" targetRef="C_Cancel" />
<bpmn:sequenceFlow id="F_G_Espera_C_Timer" name="" sourceRef="G_Espera" targetRef="C_Timer" />
<bpmn:sequenceFlow id="F_G_Espera_C_Ocup" name="" sourceRef="G_Espera" targetRef="C_Ocup" />
<bpmn:sequenceFlow id="F_C_Cancel_T_Cancelar" name="" sourceRef="C_Cancel" targetRef="T_Cancelar" />
<bpmn:sequenceFlow id="F_T_Cancelar_E_Cancel" name="" sourceRef="T_Cancelar" targetRef="E_Cancel" />
<bpmn:sequenceFlow id="F_C_Timer_T_Expirar" name="" sourceRef="C_Timer" targetRef="T_Expirar" />
<bpmn:sequenceFlow id="F_T_Expirar_E_Expira" name="" sourceRef="T_Expirar" targetRef="E_Expira" />
<bpmn:sequenceFlow id="F_C_Ocup_T_Evento" name="" sourceRef="C_Ocup" targetRef="T_Evento" />
<bpmn:sequenceFlow id="F_T_Evento_G_Conflicto" name="" sourceRef="T_Evento" targetRef="G_Conflicto" />
<bpmn:sequenceFlow id="F_G_Conflicto_E_SinConf" name="No" sourceRef="G_Conflicto" targetRef="E_SinConf" />
<bpmn:sequenceFlow id="F_G_Conflicto_T_Buscar" name="Sí" sourceRef="G_Conflicto" targetRef="T_Buscar" />
<bpmn:sequenceFlow id="F_T_Buscar_G_Alt" name="" sourceRef="T_Buscar" targetRef="G_Alt" />
<bpmn:sequenceFlow id="F_G_Alt_T_Reasignar" name="Sí" sourceRef="G_Alt" targetRef="T_Reasignar" />
<bpmn:sequenceFlow id="F_G_Alt_T_Invalidar" name="No" sourceRef="G_Alt" targetRef="T_Invalidar" />
<bpmn:sequenceFlow id="F_T_Invalidar_E_Invalida" name="" sourceRef="T_Invalidar" targetRef="E_Invalida" />
<bpmn:sequenceFlow id="F_T_Reasignar_T_NotifReasig" name="" sourceRef="T_Reasignar" targetRef="T_NotifReasig" />
<bpmn:sequenceFlow id="F_T_NotifReasig_T_Mostrar" name="nueva retención vigente" sourceRef="T_NotifReasig" targetRef="T_Mostrar" />
</bpmn:process>
