<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_FastParking" targetNamespace="https://fastparking.local/bpmn" exporter="FastParking generador" exporterVersion="1.0">
<bpmn:message id="Msg_QR" name="QR escaneado" /><bpmn:message id="Msg_Cancel" name="Cancelación" /><bpmn:message id="Msg_Ocup" name="Evento de ocupación" />
<bpmn:collaboration id="Collab_Retencion">
<bpmn:participant id="P_Conductor" name="Conductor (visitante)" />
<bpmn:participant id="P_FastParking" name="FastParking" processRef="Proc_Retencion" />
<bpmn:participant id="P_Simulador" name="Simulador de eventos de ocupación (fuente SIMULADOR)" />
<bpmn:messageFlow id="M_QR" name="escanea QR" sourceRef="P_Conductor" targetRef="S_QR" />
<bpmn:messageFlow id="M_Zonas" name="zonas y estado" sourceRef="T_Zonas" targetRef="P_Conductor" />
<bpmn:messageFlow id="M_Eleccion" name="zona elegida" sourceRef="P_Conductor" targetRef="T_Solicitar" />
<bpmn:messageFlow id="M_Retencion" name="retención y aviso" sourceRef="T_Mostrar" targetRef="P_Conductor" />
<bpmn:messageFlow id="M_Cancel" name="cancelar" sourceRef="P_Conductor" targetRef="C_Cancel" />
<bpmn:messageFlow id="M_Reasig" name="nueva zona" sourceRef="T_NotifReasig" targetRef="P_Conductor" />
<bpmn:messageFlow id="M_Ocup" name="ENTRADA / SALIDA" sourceRef="P_Simulador" targetRef="C_Ocup" />
</bpmn:collaboration>
<bpmn:process id="Proc_Retencion" name="Solicitud de retención temporal simulada y resolución de conflictos" isExecutable="false">
<bpmn:laneSet id="LaneSet_1">
<bpmn:lane id="L_PWA" name="PWA (navegador móvil)"><bpmn:flowNodeRef>S_QR</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Sesion</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Zonas</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Solicitar</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Alternativas</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Mostrar</bpmn:flowNodeRef><bpmn:flowNodeRef>T_NotifReasig</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_API" name="API y dominio (Node.js + PostgreSQL)"><bpmn:flowNodeRef>T_Bloquear</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Cupo</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Crear</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Espera</bpmn:flowNodeRef><bpmn:flowNodeRef>C_Cancel</bpmn:flowNodeRef><bpmn:flowNodeRef>C_Timer</bpmn:flowNodeRef><bpmn:flowNodeRef>C_Ocup</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Cancelar</bpmn:flowNodeRef><bpmn:flowNodeRef>E_Cancel</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Expirar</bpmn:flowNodeRef><bpmn:flowNodeRef>E_Expira</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Evento</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Conflicto</bpmn:flowNodeRef><bpmn:flowNodeRef>E_SinConf</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Buscar</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Alt</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Reasignar</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Invalidar</bpmn:flowNodeRef><bpmn:flowNodeRef>E_Invalida</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S_QR" name="QR del tiquete escaneado"><bpmn:outgoing>F_S_QR_T_Sesion</bpmn:outgoing><bpmn:messageEventDefinition id="MED_S_QR" messageRef="Msg_QR" /></bpmn:startEvent>
<bpmn:task id="T_Sesion" name="Abrir sesión anónima"><bpmn:incoming>F_S_QR_T_Sesion</bpmn:incoming><bpmn:outgoing>F_T_Sesion_T_Zonas</bpmn:outgoing></bpmn:task>
<bpmn:task id="T_Zonas" name="Mostrar zonas por piso con hora de actualización"><bpmn:incoming>F_T_Sesion_T_Zonas</bpmn:incoming><bpmn:outgoing>F_T_Zonas_T_Solicitar</bpmn:outgoing></bpmn:task>
<bpmn:task id="T_Solicitar" name="Enviar solicitud de retención"><bpmn:incoming>F_T_Zonas_T_Solicitar</bpmn:incoming><bpmn:incoming>F_T_Alternativas_T_Solicitar</bpmn:incoming><bpmn:outgoing>F_T_Solicitar_T_Bloquear</bpmn:outgoing></bpmn:task>
<bpmn:task id="T_Alternativas" name="Mostrar alternativas cercanas"><bpmn:incoming>F_G_Cupo_T_Alternativas</bpmn:incoming><bpmn:outgoing>F_T_Alternativas_T_Solicitar</bpmn:outgoing></bpmn:task>
<bpmn:task id="T_Mostrar" name="Mostrar retención y cuenta regresiva"><bpmn:incoming>F_T_Crear_T_Mostrar</bpmn:incoming><bpmn:incoming>F_T_NotifReasig_T_Mostrar</bpmn:incoming><bpmn:outgoing>F_T_Mostrar_G_Espera</bpmn:outgoing></bpmn:task>
<bpmn:task id="T_NotifReasig" name="Notificar reasignación (SSE)"><bpmn:incoming>F_T_Reasignar_T_NotifReasig</bpmn:incoming><bpmn:outgoing>F_T_NotifReasig_T_Mostrar</bpmn:outgoing></bpmn:task>
<bpmn:task id="T_Bloquear" name="Bloquear zona y calcular cupo lógico"><bpmn:incoming>F_T_Solicitar_T_Bloquear</bpmn:incoming><bpmn:outgoing>F_T_Bloquear_G_Cupo</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="G_Cupo" name="¿Cupo lógico &gt; 0 y sin retención vigente?"><bpmn:incoming>F_T_Bloquear_G_Cupo</bpmn:incoming><bpmn:outgoing>F_G_Cupo_T_Alternativas</bpmn:outgoing><bpmn:outgoing>F_G_Cupo_T_Crear</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T_Crear" name="Crear retención VIGENTE (10 min) y registrar historial"><bpmn:incoming>F_G_Cupo_T_Crear</bpmn:incoming><bpmn:outgoing>F_T_Crear_T_Mostrar</bpmn:outgoing></bpmn:task>
<bpmn:eventBasedGateway id="G_Espera" name=""><bpmn:incoming>F_T_Mostrar_G_Espera</bpmn:incoming><bpmn:outgoing>F_G_Espera_C_Cancel</bpmn:outgoing><bpmn:outgoing>F_G_Espera_C_Timer</bpmn:outgoing><bpmn:outgoing>F_G_Espera_C_Ocup</bpmn:outgoing></bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="C_Cancel" name="Cancelación solicitada"><bpmn:incoming>F_G_Espera_C_Cancel</bpmn:incoming><bpmn:outgoing>F_C_Cancel_T_Cancelar</bpmn:outgoing><bpmn:messageEventDefinition id="MED_C_Cancel" messageRef="Msg_Cancel" /></bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="C_Timer" name="Vence a los 10 min"><bpmn:incoming>F_G_Espera_C_Timer</bpmn:incoming><bpmn:outgoing>F_C_Timer_T_Expirar</bpmn:outgoing><bpmn:timerEventDefinition id="TED_C_Timer"><bpmn:timeDuration>PT10M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="C_Ocup" name="Evento de ocupación recibido"><bpmn:incoming>F_G_Espera_C_Ocup</bpmn:incoming><bpmn:outgoing>F_C_Ocup_T_Evento</bpmn:outgoing><bpmn:messageEventDefinition id="MED_C_Ocup" messageRef="Msg_Ocup" /></bpmn:intermediateCatchEvent>
<bpmn:task id="T_Cancelar" name="Marcar CANCELADA y liberar cupo"><bpmn:incoming>F_C_Cancel_T_Cancelar</bpmn:incoming><bpmn:outgoing>F_T_Cancelar_E_Cancel</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="E_Cancel" name="Retención cancelada"><bpmn:incoming>F_T_Cancelar_E_Cancel</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="T_Expirar" name="Marcar EXPIRADA"><bpmn:incoming>F_C_Timer_T_Expirar</bpmn:incoming><bpmn:outgoing>F_T_Expirar_E_Expira</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="E_Expira" name="Retención expirada"><bpmn:incoming>F_T_Expirar_E_Expira</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="T_Evento" name="Validar evento (duplicado / tardío) y actualizar ocupación"><bpmn:incoming>F_C_Ocup_T_Evento</bpmn:incoming><bpmn:outgoing>F_T_Evento_G_Conflicto</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="G_Conflicto" name="¿Ocupados + retenidas &gt; capacidad?"><bpmn:incoming>F_T_Evento_G_Conflicto</bpmn:incoming><bpmn:outgoing>F_G_Conflicto_E_SinConf</bpmn:outgoing><bpmn:outgoing>F_G_Conflicto_T_Buscar</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E_SinConf" name="Retención sigue vigente"><bpmn:incoming>F_G_Conflicto_E_SinConf</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="T_Buscar" name="Buscar zona más cercana con cupo"><bpmn:incoming>F_G_Conflicto_T_Buscar</bpmn:incoming><bpmn:outgoing>F_T_Buscar_G_Alt</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="G_Alt" name="¿Hay alternativa?"><bpmn:incoming>F_T_Buscar_G_Alt</bpmn:incoming><bpmn:outgoing>F_G_Alt_T_Reasignar</bpmn:outgoing><bpmn:outgoing>F_G_Alt_T_Invalidar</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T_Reasignar" name="Marcar REASIGNADA y crear nueva VIGENTE"><bpmn:incoming>F_G_Alt_T_Reasignar</bpmn:incoming><bpmn:outgoing>F_T_Reasignar_T_NotifReasig</bpmn:outgoing></bpmn:task>
<bpmn:task id="T_Invalidar" name="Marcar INVALIDADA y notificar (SSE)"><bpmn:incoming>F_G_Alt_T_Invalidar</bpmn:incoming><bpmn:outgoing>F_T_Invalidar_E_Invalida</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="E_Invalida" name="Retención invalidada"><bpmn:incoming>F_T_Invalidar_E_Invalida</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F_S_QR_T_Sesion" name="" sourceRef="S_QR" targetRef="T_Sesion" />
<bpmn:sequenceFlow id="F_T_Sesion_T_Zonas" name="" sourceRef="T_Sesion" targetRef="T_Zonas" />
<bpmn:sequenceFlow id="F_T_Zonas_T_Solicitar" name="" sourceRef="T_Zonas" targetRef="T_Solicitar" />
