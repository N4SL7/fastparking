digraph C4_2 { graph [fontname="Segoe UI,Arial,Helvetica,sans-serif", pad=0.4, nodesep=0.9, ranksep=1.0, bgcolor="white", labelloc=t, fontsize=16, fontcolor="#083E4D"];
node [fontname="Segoe UI,Arial,Helvetica,sans-serif", fontsize=11, margin="0.25,0.15", width=2.6];
edge [fontname="Segoe UI,Arial,Helvetica,sans-serif", fontsize=9.5, color="#4b6169", fontcolor="#33474e", arrowsize=0.8];
graph [label="C4 · Nivel 2 — Contenedores de FastParking", compound=true];
conductor [shape=box, style="rounded,filled", fillcolor="#052c37", color="#052c37", fontcolor="white", label=<<FONT POINT-SIZE="20">👤</FONT><BR/><B>Conductor / visitante</B><BR/><FONT POINT-SIZE="9">[Persona]</FONT><BR/><FONT POINT-SIZE="10">Navegador móvil</FONT>>];
operador [shape=box, style="rounded,filled", fillcolor="#052c37", color="#052c37", fontcolor="white", label=<<FONT POINT-SIZE="20">👤</FONT><BR/><B>Operador de pruebas</B><BR/><FONT POINT-SIZE="9">[Persona]</FONT><BR/><FONT POINT-SIZE="10">Terminal</FONT>>];
subgraph cluster_fp { label=<<B>FastParking</B> [Sistema de software]>; style="dashed,rounded"; color="#083E4D"; fontcolor="#083E4D"; fontsize=12;
  pwa [shape=box, style="rounded,filled", fillcolor="#083E4D", color="#083E4D", label=<<B>PWA FastParking</B><BR/><FONT POINT-SIZE="9">[Contenedor: React 18 + TypeScript + Vite, servida por nginx]</FONT><BR/><BR/><FONT POINT-SIZE="10">Tiquete con QR simulado, zonas por piso,<BR/>retención de 7 min, mapa 3D del sótano con<BR/>navegación simulada, avisos y mi vehículo.<BR/>Service worker: solo cachea la interfaz</FONT>>, fontcolor="white"];
  api [shape=box, style="rounded,filled", fillcolor="#083E4D", color="#083E4D", label=<<B>API FastParking</B><BR/><FONT POINT-SIZE="9">[Contenedor: Node.js + Express + TypeScript]</FONT><BR/><BR/><FONT POINT-SIZE="10">Monolito modular: reglas de negocio,<BR/>concurrencia, expiración, reasignación,<BR/>adaptador de eventos y notificaciones SSE</FONT>>, fontcolor="white"];
  db [shape=cylinder, style="rounded,filled", fillcolor="#083E4D", color="#083E4D", label=<<B>Base de datos</B><BR/><FONT POINT-SIZE="9">[Contenedor: PostgreSQL 16]</FONT><BR/><BR/><FONT POINT-SIZE="10">Pisos, zonas, sesiones, retenciones,<BR/>historial, eventos y ubicaciones</FONT>>, fontcolor="white"];
  sim [shape=box, style="rounded,filled", fillcolor="#083E4D", color="#083E4D", label=<<B>Simulador de eventos</B><BR/><FONT POINT-SIZE="9">[Contenedor: CLI Node.js (simulator/simular.mjs)]</FONT><BR/><BR/><FONT POINT-SIZE="10">Genera eventos ENTRADA/SALIDA<BR/>etiquetados como SIMULADOR</FONT>>, fontcolor="white"];
}
sens [shape=box, style="rounded,filled,dashed", fillcolor="#9aa8ad", color="#10242a", label=<<B>Sensores del parqueadero</B><BR/><FONT POINT-SIZE="9">[Sistema externo — FUTURO]</FONT><BR/><BR/><FONT POINT-SIZE="10">No integrado</FONT>>, fontcolor="white"];
conductor -> pwa [label="  Usa (HTTPS)"];
operador -> sim [label="  Ejecuta escenarios"];
pwa -> api [label="  REST JSON /api/*\n  + SSE /api/events/stream"];
sim -> api [label="  POST /api/simulator/events\n  (x-simulator-key)"];
api -> db [label="  SQL (pg) con transacciones\n  y SELECT … FOR UPDATE"];
sens -> api [style=dashed, label="  (futuro) mismo contrato\n  del adaptador"];
{rank=same; conductor; operador}
{rank=same; pwa; sim}
}