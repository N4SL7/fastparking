digraph MER {
graph [rankdir=LR, splines=ortho, nodesep=0.7, ranksep=1.1, fontname="Segoe UI,Arial,Helvetica,sans-serif", pad=0.3, bgcolor="white",
       label="FastParking — Modelo Entidad-Relación v1.0 (PostgreSQL)   ·   PK clave primaria · FK clave foránea · UK única", labelloc=t, fontsize=16, fontcolor="#083E4D"];
node [shape=plaintext, fontname="Segoe UI,Arial,Helvetica,sans-serif", fontsize=10];
edge [fontname="Segoe UI,Arial,Helvetica,sans-serif", fontsize=9, color="#10242a", dir=both, fontcolor="#083E4D"];
piso [label=<<TABLE BORDER="1" COLOR="#083E4D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#083E4D"><FONT COLOR="white"><B>PISO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#083E4D"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id_piso</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#083E4D"><B>UK</B></FONT></TD><TD ALIGN="LEFT">codigo</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">VARCHAR(10)</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#083E4D"><B>UK</B></FONT></TD><TD ALIGN="LEFT">orden</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">SMALLINT</FONT></TD></TR></TABLE>>];
zona [label=<<TABLE BORDER="1" COLOR="#083E4D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#083E4D"><FONT COLOR="white"><B>ZONA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#083E4D"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id_zona</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#083E4D"><B>FK</B></FONT></TD><TD ALIGN="LEFT">id_piso</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#083E4D"><B>UK</B></FONT></TD><TD ALIGN="LEFT">codigo</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">VARCHAR(10)</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">VARCHAR(40)</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">capacidad_total</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">INTEGER &gt; 0</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">ocupados</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">INTEGER 0..capacidad</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">orden_cercania</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">SMALLINT</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">ultimo_evento_en</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">TIMESTAMPTZ</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">TIMESTAMPTZ</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">es_simulada</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">BOOLEAN</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4b6169">UK (id_piso, orden_cercania)</FONT></TD></TR></TABLE>>];
sesion_visita [label=<<TABLE BORDER="1" COLOR="#083E4D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#083E4D"><FONT COLOR="white"><B>SESION_VISITA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#083E4D"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id_sesion</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#083E4D"><B>UK</B></FONT></TD><TD ALIGN="LEFT">token_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">CHAR(64) SHA-256</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">creada_en</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">TIMESTAMPTZ</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">expira_en</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">TIMESTAMPTZ</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4b6169">CHECK expira_en &gt; creada_en · sin datos personales</FONT></TD></TR></TABLE>>];
retencion [label=<<TABLE BORDER="1" COLOR="#083E4D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#083E4D"><FONT COLOR="white"><B>RETENCION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#083E4D"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id_retencion</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#083E4D"><B>FK</B></FONT></TD><TD ALIGN="LEFT">id_sesion</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#083E4D"><B>FK</B></FONT></TD><TD ALIGN="LEFT">id_zona</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#083E4D"><B>FK</B></FONT></TD><TD ALIGN="LEFT">id_retencion_origen</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">UUID (nula)</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">VARCHAR(12)</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">creada_en</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">TIMESTAMPTZ</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">vence_en</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">TIMESTAMPTZ</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">cerrada_en</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">TIMESTAMPTZ (nula)</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">motivo_cierre</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">VARCHAR(60)</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#4b6169">estado ∈ VIGENTE·CANCELADA·EXPIRADA·REASIGNADA·INVALIDADA·UTILIZADA<BR ALIGN="LEFT"/>CHECK vence_en &gt; creada_en · única VIGENTE por sesión<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
historial_retencion [label=<<TABLE BORDER="1" COLOR="#083E4D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#083E4D"><FONT COLOR="white"><B>HISTORIAL_RETENCION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#083E4D"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id_historial</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">BIGSERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#083E4D"><B>FK</B></FONT></TD><TD ALIGN="LEFT">id_retencion</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#083E4D"><B>FK</B></FONT></TD><TD ALIGN="LEFT">id_evento</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">UUID (nula)</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">estado_anterior</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">VARCHAR(12)</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">estado_nuevo</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">VARCHAR(12)</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">motivo</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">VARCHAR(60)</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">registrado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
evento_ocupacion [label=<<TABLE BORDER="1" COLOR="#083E4D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#083E4D"><FONT COLOR="white"><B>EVENTO_OCUPACION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#083E4D"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id_evento</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">UUID (idempotencia)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#083E4D"><B>FK</B></FONT></TD><TD ALIGN="LEFT">id_zona</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">SMALLINT</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">tipo</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">ENTRADA · SALIDA</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">cantidad</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">SMALLINT &gt; 0</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">fuente</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">SIMULADOR · CONDUCTOR</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">ocurrido_en</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">TIMESTAMPTZ</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">recibido_en</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">TIMESTAMPTZ</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">resultado</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">APLICADO · DESCARTADO_TARDIO</FONT></TD></TR></TABLE>>];
ubicacion_vehiculo [label=<<TABLE BORDER="1" COLOR="#083E4D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#083E4D"><FONT COLOR="white"><B>UBICACION_VEHICULO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#083E4D"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id_ubicacion</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#083E4D"><B>FK UK</B></FONT></TD><TD ALIGN="LEFT">id_sesion</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="34"><FONT COLOR="#083E4D"><B>FK</B></FONT></TD><TD ALIGN="LEFT">id_zona</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">SMALLINT</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">puesto</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">SMALLINT &gt; 0 (nulo)</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">referencia</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">VARCHAR(80)</FONT></TD></TR><TR><TD WIDTH="34"> </TD><TD ALIGN="LEFT">registrada_en</TD><TD ALIGN="LEFT"><FONT COLOR="#4b6169">TIMESTAMPTZ</FONT></TD></TR></TABLE>>];
piso -> zona [arrowtail=teetee, arrowhead=crowtee, xlabel="contiene  1 : 1..N"];
zona -> retencion [arrowtail=teetee, arrowhead=crowodot, xlabel="es retenida en  1 : 0..N"];
sesion_visita -> retencion [arrowtail=teetee, arrowhead=crowodot, xlabel="solicita  1 : 0..N"];
retencion -> retencion [arrowtail=teeodot, arrowhead=teeodot, xlabel="origina (reasignación)  0..1 : 0..1"];
retencion -> historial_retencion [arrowtail=teetee, arrowhead=crowtee, xlabel="registra  1 : 1..N"];
evento_ocupacion -> historial_retencion [arrowtail=teeodot, arrowhead=crowodot, xlabel="provoca  0..1 : 0..N"];
zona -> evento_ocupacion [arrowtail=teetee, arrowhead=crowodot, xlabel="recibe  1 : 0..N"];
sesion_visita -> ubicacion_vehiculo [arrowtail=teetee, arrowhead=teeodot, xlabel="guarda  1 : 0..1"];
zona -> ubicacion_vehiculo [arrowtail=teetee, arrowhead=crowodot, xlabel="ubica  1 : 0..N"];
}